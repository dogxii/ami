{
  "name": "@dogxi/ami",
  "version": "0.6.0",
  "description": "A lightweight native terminal agent written in Go.",
  "type": "module",
  "bin": {
    "ami": "bin/ami.js"
  },
  "files": [
    "bin/ami.js",
    "bin/install.js",
    "README.md",
    "docs/architecture.md"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "dev": "go run ./cmd/ami",
    "build": "node scripts/build.mjs",
    "start": "node bin/ami.js",
    "test": "go test -race -timeout 3m ./... && node --test test/npm.test.mjs",
    "typecheck": "go vet ./...",
    "verify:release": "node scripts/verify-release.mjs",
    "postinstall": "node bin/install.js"
  },
  "keywords": [
    "cli",
    "agent",
    "llm",
    "tool-call"
  ],
  "license": "MIT"
}
